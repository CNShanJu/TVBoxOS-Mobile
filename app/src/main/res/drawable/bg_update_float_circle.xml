<?xml version="1.0" encoding="utf-8"?>
<!-- 全局更新悬浮圆钮背景:主题灰底(bg_popup,明暗自适应)+ 高亮描边(color_highlight),
     与全 App 悬浮钮/强调风格一致,任何页面背景下都清晰;不再用纯色块突兀圆圈 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/bg_popup" />
    <stroke
        android:width="1.5dp"
        android:color="@color/color_highlight" />
</shape>
