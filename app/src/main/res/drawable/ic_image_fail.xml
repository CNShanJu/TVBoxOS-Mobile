        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M2 17 L8 11 L12 15 L16 11 L22 17" />

    <!-- 太阳 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#7A000000"
        android:strokeWidth="1.2"
        android:pathData="M14 7 a1.5 1.5 0 1 0 0.001 0 z" />

    <!-- 红色斜杠(加载失败) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD32F2F"
