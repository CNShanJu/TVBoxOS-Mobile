        android:pathData="M4 3 h16 a1 1 0 0 1 1 1 v16 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 V4 a1 1 0 0 1 1 -1 z" />

    <!-- 山 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#7A000000"
