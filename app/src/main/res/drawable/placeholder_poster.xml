<?xml version="1.0" encoding="utf-8"?>
<!-- 全 App 图片统一加载占位组件(改此处一处,所有图片占位符一起生效):
     主题灰底 @color/bg_component + 居中矢量图标(ic_image_placeholder,任意尺寸清晰)。
     底为不透明组件色、图标等比居中,不随盒子缩放裁剪;明暗主题一致。
     若需换占位图形,替换 ic_image_placeholder.xml 的 pathData 即可。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_component" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_image_placeholder"
        android:gravity="center" />
</layer-list>
