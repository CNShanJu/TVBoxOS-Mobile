<?xml version="1.0" encoding="utf-8"?>
<!-- 全 App 图片统一加载占位组件(改此处一处,所有图片占位符一起生效):
     主题灰底 @color/bg_component + 居中占位图标 ic_image_placeholder。
     规则:占位符图片只能用 ic_image_placeholder.xml(由 D:\Code\Video\icon\图片加载失败.svg 转矢量),
     禁止改用其它占位图/位图(如 iv_load_fail / img_loading_placeholder / ic_img_placeholder 等)。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_component" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_image_placeholder"
        android:gravity="center" />
</layer-list>
