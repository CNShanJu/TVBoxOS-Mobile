<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.MainActivity">

    <!-- 内容全高延伸到屏幕底部(毛玻璃底栏覆盖其上, 模糊区域才有内容) -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 毛玻璃底栏:悬浮覆盖在内容之上(三层: 模糊层 → 磨砂遮罩+顶部线 → 清晰图标)。
         阴影由容器 elevation 提供; 内层 BottomNavigationView 透明, 绕开 MaterialShapeDrawable 变暗 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:elevation="10dp">

        <!-- 1. 模糊层:实时模糊其下方(ViewPager 列表)内容 -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 2. 磨砂遮罩:半透明页面背景色 + 顶部 1dp 细线(亮色淡/暗色白) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_nav" />

        <!-- 3. 图标层:透明背景, 内容清晰绘制在模糊之上 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                app:compatShadowEnabled="false"
                app:itemActiveIndicatorStyle="@style/EmptyActiveIndicator"
                app:itemIconSize="22dp"
                app:itemIconTint="@drawable/bottom_navigation_item_selector"
                app:itemPaddingTop="10dp"
                app:itemPaddingBottom="11dp"
                app:itemTextAppearanceActive="@style/NavItemTextAppearance"
                app:itemTextAppearanceInactive="@style/NavItemTextAppearance"
                app:itemTextColor="@drawable/bottom_navigation_item_selector"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/main_bottom_navigation"/>
    </FrameLayout>
</FrameLayout>
