<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏(默认)播放底部控制: 进度/时间独立上行, 按钮行保持在下 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 上行: 当前时间 + 进度条 + 总时长 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/curr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:text="00:00"
            android:textColor="@color/color_FFFFFF"
            android:layout_marginLeft="4dp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:padding="@dimen/dp_0"
            android:paddingStart="@dimen/dp_0"
            android:paddingEnd="@dimen/dp_0"
            android:progressDrawable="@drawable/shape_player_control_vod_seek"
            android:thumb="@drawable/shape_player_control_vod_seek_thumb"
            android:thumbOffset="@dimen/dp_0" />

        <TextView
            android:id="@+id/total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_10"
            android:paddingLeft="@dimen/dp_10"
            android:text="00:00"
            android:textColor="@color/color_FFFFFF"
            android:layout_marginRight="4dp" />
    </LinearLayout>

    <!-- 下行: 播放控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_status"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:src="@drawable/ic_pause"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_pre"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:src="@drawable/ic_play_pre"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_play_next"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/choose_series"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:visibility="gone"
            tools:visibility="visible"
            android:text="选集"
            android:textSize="16sp"
            android:layout_marginLeft="4dp" />

        <TextView
            android:id="@+id/choose_download"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:visibility="gone"
            tools:visibility="visible"
            android:text="下载"
            android:textSize="16sp"
            android:layout_marginLeft="4dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_fullscreen"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:src="@drawable/ic_zoom_in"/>
    </LinearLayout>
</LinearLayout>
