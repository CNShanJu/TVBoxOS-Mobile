<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="10dp"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="20dp"
    android:orientation="horizontal">

    <!-- 海报图:图/文 weight 3.5/6.5;圆角由 View 层裁切兜底(加载/占位也圆角) -->
    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="0dp"
        android:layout_weight="3.5"
        android:layout_height="match_parent"
        android:background="@drawable/bg_img_round_corner"
        android:clipToOutline="true"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="6.5"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="肖申克的救赎"
            android:textColor="@color/text_foreground"
            android:ellipsize="end"
            android:singleLine="true"
            />

        <TextView
            android:id="@+id/tvSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="剪片小站"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_highlight"
            android:textSize="12sp"
            />

        <!-- 弹性占位:把"更新集数"压到接近图片底部但留出内边距 -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="更新至10集 1080p"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp"
            />
    </LinearLayout>

</LinearLayout>