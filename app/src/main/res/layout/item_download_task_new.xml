<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_large_round_gray"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 多选勾选框:仅长按多选(组内条目)时显示 -->
        <CheckBox
            android:id="@+id/cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <!-- 封面图(剧集海报,本地文件,缺失显示占位图) -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_cover"
            android:layout_width="56dp"
            android:layout_height="74dp"
            android:background="@color/gray_darker_press_alpha"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 行1:剧名 · 集名 -->
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 行2:状态 · 进度 -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp" />

            <!-- 行3:大小 · 速度 -->
            <TextView
                android:id="@+id/tv_size_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />

            <!-- 行4:来源 · 存储位置 -->
            <TextView
                android:id="@+id/tv_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_sub_foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 操作按钮:随状态切换 暂停/继续/重试(多选模式下隐藏) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"
            style="@style/mbOutline"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="暂停" />
    </LinearLayout>

    <!-- 更多操作行:失败显示重试,长按/点更多删除(多选模式下隐藏) -->
    <LinearLayout
        android:id="@+id/ll_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_more_delete"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:foreground="?selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="删除"
            android:textColor="@color/red"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_more_retry"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:foreground="?selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="重试"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
