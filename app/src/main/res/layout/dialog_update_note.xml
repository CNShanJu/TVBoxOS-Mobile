<?xml version="1.0" encoding="utf-8"?>
<!-- 更新确认弹窗:标题 + 版本说明(Markdown 渲染、左对齐、可滚动)+ 立即更新/稍后 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="发现新版本"
            android:textColor="@color/text_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/note_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_close_24"
            app:tint="@color/text_foreground" />
    </LinearLayout>

    <!-- 说明区:可滚动、文本左对齐(Markdown 渲染由代码完成) -->
    <ScrollView
        android:id="@+id/note_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/note_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_foreground"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_later"
            style="@style/mbOutline"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:focusable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/text_foreground"
            android:text="稍后" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_update"
            style="@style/mbSolid"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_weight="1"
            android:focusable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="立即更新" />
    </LinearLayout>
</LinearLayout>
