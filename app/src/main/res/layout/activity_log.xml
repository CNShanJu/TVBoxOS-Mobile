<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.github.tvbox.osc.ui.widget.AppTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:title="运行日志">

        <!-- 复制按钮:子 View 方式,与左侧返回图标保持同一水平线 -->
        <ImageView
            android:id="@+id/btn_copy"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:contentDescription="复制日志"
            android:src="@drawable/ic_copy" />
    </com.github.tvbox.osc.ui.widget.AppTitleBar>

    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:text="仅显示最近 1000 行"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp" />

    <!-- Tab 切换:业务日志(结构化可筛选) / 全部日志(logcat 原始流) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tab_biz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_filter_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="业务日志"
            android:textColor="@color/text_foreground"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_tab_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/selector_filter_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="全部日志"
            android:textColor="@color/text_sub_foreground"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 业务日志模块筛选:大类型 + 仅错误(横向可滚动,窄屏不换行挤压) -->
    <HorizontalScrollView
        android:id="@+id/ll_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/ft_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="全部"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/ft_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="下载"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/ft_player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="播放"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/ft_subscription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="订阅"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/ft_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selector_filter_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="系统"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/ft_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_filter_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="仅错误"
                android:textColor="@color/text_sub_foreground"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 日期选择入口:点击弹出底部抽屉选择日期 -->
    <LinearLayout
        android:id="@+id/ll_date_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_large_round_gray"
        android:foreground="?android:selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tv_selected_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="暂无日志"
            android:textColor="@color/text_foreground"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/text_sub_foreground" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="14dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_large_round_gray"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/text_foreground"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>

        <!-- 点击直接滚动到底部 -->
        <ImageView
            android:id="@+id/btn_scroll_bottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_semi_black_circle"
            android:contentDescription="滚动到底部"
            android:foreground="?selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_down" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/mbOutline"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            android:text="清 空" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export"
            style="@style/mbOutline"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="导 出" />
    </LinearLayout>

</LinearLayout>
